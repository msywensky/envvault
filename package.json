{
  "name": "envvault",
  "version": "0.1.0",
  "description": "Sync per-project .env files between machines through an encrypted vault folder",
  "main": "./out/main/index.js",
  "bin": {
    "envvault": "out/cli/envvault.mjs"
  },
  "author": "Mike Sywensky",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msywensky/envvault.git"
  },
  "homepage": "https://github.com/msywensky/envvault#readme",
  "bugs": {
    "url": "https://github.com/msywensky/envvault/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache --max-warnings 0 .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "check": "node scripts/verify.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:profile": "node scripts/dev-profile.mjs",
    "build": "npm run typecheck && electron-vite build && npm run build:cli",
    "build:cli": "vite build -c vite.cli.config.mts",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "deploy:win": "pwsh -NoProfile -File scripts/deploy-win.ps1",
    "deploy:mac": "bash scripts/deploy-mac.sh",
    "build:linux": "npm run build && electron-builder --linux",
    "prepare": "husky"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-vue-next": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "dotenv": "16.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{ts,mts,vue,js,mjs}": "eslint --max-warnings 0"
  }
}
